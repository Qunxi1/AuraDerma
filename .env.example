# AuraDerma local configuration
# Copy this file to .env and fill in the real values.

# DeepSeek / OpenAI-compatible model endpoint
AURADERMA_MODEL_BASE=https://api.deepseek.com
AURADERMA_MODEL_API_KEY=
AURADERMA_DEFAULT_MODEL=deepseek-v4-flash

# Qdrant
AURADERMA_QDRANT_URL=http://localhost:6388
AURADERMA_QDRANT_API_KEY=
AURADERMA_QDRANT_PRODUCTS=AuraDerma_products
AURADERMA_QDRANT_MEMORY=AuraDerma_memory
AURADERMA_QDRANT_DOCS=AuraDerma_docs

# Skills registry directory
AURADERMA_SKILLS_DIR=./skills

# Memory/data directory
AURADERMA_DATA_DIR=./data

# ============================================================
# Web 搜索配置
# ============================================================
AURADERMA_WEB_SEARCH_ENABLED=true

# 搜索提供方（默认 bing，HTML 爬取 cn.bing.com，无需 API Key）
# 可选：bing, bing-intl, searxng, metaso, baidu, tavily,
#       perplexity, exa, brave, ollama
AURADERMA_WEB_SEARCH_PROVIDER=bing
